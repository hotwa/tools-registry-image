[Unit]
Description=Pull and safely deploy the promoted Treg stable image
Requires=docker.service
After=docker.service network-online.target gateway-stack.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/treg-registry-deploy.env
ExecStart=/usr/local/libexec/treg-registry-deploy/check-stable-and-deploy.sh
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
